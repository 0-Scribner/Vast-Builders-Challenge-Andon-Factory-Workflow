# Names only. Copy to .env on the laptop and fill from logged-in services.
# Never commit the filled .env. Source with: set -a && source .env && set +a
# Official names: https://github.com/vast-data/vast-builders-challenge config.example

# GitHub (gh auth login). Optional override for the public mirror.
# GITHUB_REPO=https://github.com/<login>/Scribner.git

# W&B Inference (wandb login). BUILD_DAY.md.
# WANDB_API_KEY=
# WANDB_TEAM=
# WANDB_PROJECT=

# VSS / workshop VM (/config/<team>.config). Optional on the laptop.
# INGRESS_URL=
# USERNAME=
# PASSWORD=

# GPU NIMs from the same config. Optional on the laptop.
# COSMOS3_REASON_URL=
# YOLO_URL=
# COSMOS_EMBED1_URL=
# GPU_BEARER_TOKEN=
# COSMOS3_REASON_MODEL=nvidia/cosmos3-reason
# COSMOS_EMBED1_MODEL=nvidia/cosmos-embed1

# Deploy aliases (deployment/deploy-app-no-registry). Optional.
# VSS_URL=
# VSS_USERNAME=
# VSS_PASSWORD=

# Local
SCRIBNER_MOCK=1
# SCRIBNER_PACK=C
# SCRIBNER_CAMERA_ID=sdg_warehouse_cam-2
# SCRIBNER_SEARCH_QUERY=person close to a moving vehicle
# BUILDERS_CHALLENGE_DIR=/tmp/vast-builders-challenge
# KIT_CLIPS_DIR=~/kit-clips
